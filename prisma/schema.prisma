generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminAuthKey {
  id        String   @id @default(cuid())
  keyHash   String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  status    AuthKeyStatus @default(ACTIVE)
  createdBy String?

  @@index([status])
  @@index([expiresAt])
}

enum AuthKeyStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

model AdminSession {
  id           String   @id @default(cuid())
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  revokedAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  type      SecurityEventType
  severity  SecuritySeverity
  message   String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([severity])
}

enum SecurityEventType {
  ADMIN_LOGIN_SUCCESS
  ADMIN_LOGIN_FAILED
  ADMIN_KEY_GENERATED
  ADMIN_KEY_ROTATED
  ADMIN_KEY_REVOKED
  ADMIN_KEY_USED
  ADMIN_SESSION_REVOKED
  ADMIN_LOCKDOWN_ACTIVATED
  RATE_LIMIT_EXCEEDED
  UNAUTHORIZED_ACCESS_ATTEMPT
  FILE_UPLOAD_SUSPICIOUS
  SETTINGS_CHANGED
  BACKUP_CREATED
  BACKUP_RESTORED
}

enum SecuritySeverity {
  INFO
  WARNING
  CRITICAL
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  resource  String
  resourceId String?
  userId    String?
  sessionId String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  result    AuditResult
  createdAt DateTime @default(now())

  @@index([action])
  @@index([resource])
  @@index([userId])
  @@index([createdAt])
}

enum AuditResult {
  SUCCESS
  FAILURE
  PARTIAL
}

model Video {
  id          String   @id @default(cuid())
  youtubeId   String   @unique
  youtubeUrl  String
  title       String
  description String?
  thumbnail   String?
  category    String?
  tags        String[]
  views       Int      @default(0)
  publishedAt DateTime?
  featured    Boolean  @default(false)
  visible     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([featured])
  @@index([visible])
  @@index([category])
  @@index([publishedAt])
  @@index([sortOrder])
}

model Project {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  longDescription String?  @db.Text
  icon            String?
  coverImage      String?
  status          ProjectStatus @default(IDEA)
  category        String?
  technologies    String[]
  githubUrl       String?
  demoUrl         String?
  websiteUrl      String?
  featured        Boolean  @default(false)
  visibility      ProjectVisibility @default(PRIVATE)
  showOnRoadmap   Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tasks           ProjectTask[]
  files           ProjectFile[]
  flowchart       Flowchart?
  notes           ProjectNote[]
  changelog       ChangelogEntry[]
  roadmapItems    RoadmapItem[]

  @@index([status])
  @@index([visibility])
  @@index([featured])
  @@index([showOnRoadmap])
  @@index([category])
  @@index([sortOrder])
}

enum ProjectStatus {
  IDEA
  PLANNING
  DEVELOPMENT
  TESTING
  BETA
  RELEASED
  PAUSED
  ARCHIVED
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

model ProjectTask {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  status      TaskStatus @default(TODO)
  priority    TaskPriority @default(NORMAL)
  tags        String[]
  deadline    DateTime?
  dependencies String[]
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([sortOrder])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  TESTING
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model ProjectFile {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  path        String
  type        FileType
  size        BigInt
  mimeType    String?
  parentId    String?
  parent      ProjectFile? @relation("FileHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProjectFile[] @relation("FileHierarchy")
  content     String?  @db.Text
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions    ProjectFileVersion[]

  @@index([projectId])
  @@index([parentId])
  @@index([path])
  @@index([type])
}

enum FileType {
  FILE
  FOLDER
}

model ProjectFileVersion {
  id        String   @id @default(cuid())
  fileId    String
  file      ProjectFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  version   Int
  message   String?
  createdAt DateTime @default(now())
  createdBy String?

  @@unique([fileId, version])
  @@index([fileId])
}

model Flowchart {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  data      Json
  viewport  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FlowchartNode {
  id          String   @id @default(cuid())
  flowchartId String
  flowchart   Flowchart @relation(fields: [flowchartId], references: [id], onDelete: Cascade)
  type        String
  position    Json
  data        Json
  width       Float?
  height      Float?
  selected    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([flowchartId])
}

model FlowchartEdge {
  id           String   @id @default(cuid())
  flowchartId  String
  flowchart    Flowchart @relation(fields: [flowchartId], references: [id], onDelete: Cascade)
  source       String
  target       String
  sourceHandle String?
  targetHandle String?
  type         String?
  data         Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([flowchartId])
  @@index([source])
  @@index([target])
}

model ProjectNote {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model ChangelogEntry {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   String
  title     String?
  content   String   @db.Text
  releasedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([releasedAt])
}

model RoadmapItem {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  status      RoadmapStatus @default(IDEA)
  targetDate  DateTime?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([targetDate])
  @@index([sortOrder])
}

enum RoadmapStatus {
  IDEA
  PLANNING
  DEVELOPMENT
  TESTING
  RELEASED
}

model Media {
  id        String   @id @default(cuid())
  name      String
  path      String   @unique
  url       String
  type      MediaType
  size      BigInt
  mimeType  String
  width     Int?
  height    Int?
  alt       String?
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([tags])
}

enum MediaType {
  IMAGE
  GIF
  SVG
  VIDEO
  DOCUMENT
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   Json
  seoTitle  String?
  seoDesc   String?
  seoImage  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([published])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  type      SettingType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  ARRAY
  OBJECT
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  message   String   @db.Text
  url       String?
  startDate DateTime
  endDate   DateTime?
  style     AnnouncementStyle @default(INFO)
  enabled   Boolean  @default(true)
  public    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([public])
  @@index([startDate])
  @@index([endDate])
}

enum AnnouncementStyle {
  INFO
  SUCCESS
  WARNING
  ERROR
  NEUTRAL
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  page      String?
  referrer  String?
  device    String?
  browser   String?
  os        String?
  country   String?
  region    String?
  city      String?
  metadata  Json?
  sessionId String
  createdAt DateTime @default(now())

  @@index([event])
  @@index([page])
  @@index([sessionId])
  @@index([createdAt])
  @@index([country])
}

model Notification {
  id        String   @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([read])
  @@index([type])
  @@index([createdAt])
}

enum NotificationType {
  SECURITY
  VIDEO
  PROJECT
  FILE
  WEBHOOK
  BACKUP
  SYSTEM
}

model Backup {
  id          String   @id @default(cuid())
  name        String
  path        String   @unique
  size        BigInt
  type        BackupType @default(FULL)
  status      BackupStatus @default(PENDING)
  metadata    Json?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([createdAt])
}

enum BackupType {
  FULL
  DATABASE
  FILES
  MEDIA
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model AdminUser {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  role          AdminRole @default(OWNER)
  permissions   String[]
  passwordHash  String?
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
  @@index([role])
}

enum AdminRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model AdminSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}